# Copy this to .env and fill in real values. Never commit the real .env.

CLIENT_ID=
TENANT_ID=consumers

# Leave NOTIFICATION_URL unset to auto-detect the quick-tunnel URL from the
# cloudflared container (recommended - see README). Only set this manually
# if you're using a named/stable tunnel with your own domain.
NOTIFICATION_URL=https://example.com/notifications

# Any long random string - generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIENT_STATE=

# Only needed if you switch docker-compose.yml to the named-tunnel option
CLOUDFLARE_TUNNEL_TOKEN=

ACCOUNTS=name1,name2